<?xml version="1.0" encoding="UTF-8"?>
<SubWindow
        id="settingPauseContainer"
        x="192" y="48" width="384" height="480">
    <TextView
            id="settingPauseText"
            x="192" y="48" width="384" height="100"
            text="Tùy chọn"
            shadow="true"
            alignment="center"
            fontSize="30"
            color="#FFFFFF" />

    <TextView
            id="settingPauseTextNum1"
            x="215" y="198" width="100" height="50"
            text="Nhạc"
            alignment="right|center"
            fontSize="19"
            color="#FFFFFF" >

    </TextView>

    <TextView
            id="settingPauseTextNum2"
            x="215" y="273" width="100" height="50"
            text="SFX"
            alignment="right|center"
            fontSize="19"
            color="#FFFFFF" >

    </TextView>

    <ValueAdjuster
            id="volumePauseAdjusterMusic"
            x="400"
            y="198"
            width="70"
            height="50"
            value="40"
            lowerThreshold="0"
            upperThreshold="100"
            fontSize="18"
            color="#FFFFFF"
            roundRadius="30"/>

    <ValueAdjuster
            id="volumePauseAdjusterSFX"
            x="400"
            y="273"
            width="70"
            height="50"
            value="40"
            lowerThreshold="0"
            upperThreshold="100"
            fontSize="18"
            color="#FFFFFF"
            roundRadius="30"/>

    <GameButton
            id="tryAgainButton"
            x="284" y="343" width="200" height="60"
            text="Thử lại"
            fontSize="19"
            color="#FFFFFF" />

    <GameButton
            id="resumeButton"
            x="284" y="423" width="200" height="60"
            text="Tiếp tục"
            fontSize="19"
            color="#FFFFFF" />

</SubWindow>
