<?xml version="1.0" encoding="UTF-8"?>
<SubWindow id="passwordContainer" x="100" y="100" width="576" height="200">
    <TextView
            id="enterPasswordText"
            x="120" y="162" width="100" height="30"
            text="Nhập mật khẩu"
            shadow="false"
            alignment="left|top"
            fontSize="20"
            color="#FFFFFF"/>

    <SubWindow
            id="passwordBox"
            x="400" y="155" width="200" height="30">
        <EditPassword
                id="editPassword"
                x="410" y="155" width="190" height="30"
                text=""
                maxLength="4"
                shadow="false"
                alignment="center"
                fontSize="20"
                color="#FFFFFF"/>

        <TextView
                id="pressEnterToConfirm"
                x="120" y="250" width="100" height="30"
                text="Nhấn Enter để xác nhận"
                shadow="false"
                alignment="left|top"
                fontSize="20"
                color="#FFFFFF"/>

    </SubWindow>

    <GameButton
            id="confirmButton"
            x="550" y="252" width="120" height="20"
            text="Xác nhận"
            fontSize="15"
            color="#FFFFFF"
            roundRadius="30"/>


</SubWindow>